     "label": "Description",
     "type": "text"
    },
    {
     "name": "qty",
     "label": "Qty",
     "type": "number"
    },
    {
     "name": "unit_price",
     "label": "Unit Price",
     "type": "amount",
     "format": "# ###,##"
    },
    {
